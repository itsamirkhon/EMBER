{
  "name": "ember-final",
  "private": true,
  "version": "2.1.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc --noEmit -p tsconfig.json && vite build",
    "preview": "vite preview",
    "test": "vitest run",
    "lint": "tsc --noEmit -p tsconfig.json && tsc --noEmit -p tsconfig.node.json",
    "eval": "tsx eval/run_evaluation.ts",
    "corpus": "python3 pipeline/build_corpus.py",
    "embeddings:openrouter": "node --env-file-if-exists=.env --import tsx pipeline/embed_openrouter.ts",
    "eval:interpret": "tsx eval/interpret/run.ts",
    "eval:interpret:numeric": "tsx eval/interpret/run-numeric.ts",
    "test:intro": "node --test tests/presentation/support.test.cjs",
    "data:compact": "tsx scripts/build-compact.mts",
    "data:trust": "tsx scripts/build-trust.mts",
    "data:ask": "tsx scripts/build-ask-answers.mts",
    "intro": "python3 scripts/build-intro.py"
  },
  "dependencies": {
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "react-router-dom": "^7.18.5"
  },
  "devDependencies": {
    "@types/node": "^26.6.6",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.3.0",
    "tsx": "^4.23.15",
    "typescript": "^7.0.2",
    "vite": "^8.3.8",
    "vitest": "^5.1.0"
  }
}
